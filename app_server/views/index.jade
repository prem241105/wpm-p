extends layout

block content
  .row.banner
    .col-12
      h1 Loc8r
        p Find places to work with wifi near you!
  .row
    .col-12.col-lg-8
      .row
        .col-12
          .card
            .card-body
h4
    a(href="/location") Starcups
    span.badge.badge-pill.badge-primary.float-right 100m
              p.address 125 High Street, Reading, RG6 1PS
              p.facilities
                span.badge.badge-warning Hot drinks
                span.badge.badge-warning Food
                span.badge.badge-warning Premium wifi
      .row
        .col-12
          .card
            .card-body
h4
    a(href="/location") Cafe Hero
    span.badge.badge-pill.badge-primary.float-right 200m
              p.address 125 High Street, Reading, RG6 1PS
              p.facilities
                span.badge.badge-warning Hot drinks
                span.badge.badge-warning Food
                span.badge.badge-warning Premium wifi
      .row
        .col-12
          .card
            .card-body
h4
    a(href="/location") Burger Queen
    span.badge.badge-pill.badge-primary.float-right 250m
              p.address 125 High Street, Reading, RG6 1PS
              p.facilities
                span.badge.badge-warning Food
                span.badge.badge-warning Premium wifi
    .col-12.col-lg-4
      p.lead Looking for wifi and a seat? Loc8r helps you find places to work when out and about. Perhaps with coffee, cake or a pint? Let Loc8r help you find the place you're looking for.
